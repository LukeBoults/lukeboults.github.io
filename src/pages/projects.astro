---
import { getCollection } from 'astro:content';
const projects = await getCollection('projects');
projects.sort((a, b) => new Date(b.data.date) - new Date(a.data.date));
const gameProjects = projects.filter(p => p.data.category === 'games');
const cyberProjects = projects.filter(p => p.data.category === 'cybersecurity');
---

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Projects - Luke Boulter</title>
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png">
    <link rel="stylesheet" href="/style.css">
    <link href="https://fonts.googleapis.com/css2?family=Source+Code+Pro:wght@400;700&display=swap" rel="stylesheet">
</head>
<body>
    <nav class="navbar">
        <ul>
            <li><a class="home-btn" href="/">Home</a></li>
            <li><a href="/projects">Projects</a></li>
            <li><a href="/blog">Blog</a></li>
            <li><a href="/ppitch">Project Pitch</a></li>
        </ul>
    </nav>

    <div class="main-layout">
        <div class="content-backdrop">
            <header id="hero">
                <h1>Project List</h1>
                <p class="intro-text">
                    Here are some of the games and cybersecurity projects I've worked on.
                    Each project represents my journey as a developer, combining design, programming, and problem solving.
                </p>
                <p class="intro-text">
                    <strong>Click on projects to find out more!</strong>
                </p>
            </header>

            <hr>

            <h2 class="category-heading">Games</h2>
            <section id="project-gallery" class="projects-grid">
                {gameProjects.length > 0 ? gameProjects.map(project => (
                    <div class="project-row">
                        <h2>{project.data.title}</h2>
                        <a class="project-card" href={project.data.link ?? `/projects/${project.id}`}>
                            <img src={project.data.image} alt={`${project.data.title} Screenshot`} class="project-img" />
                            <div class="overlay">
                                <div class="overlay-content">
                                    <span class="overlay-title">{project.data.title}</span>
                                    <p class="overlay-desc">{project.data.description}</p>
                                </div>
                            </div>
                        </a>
                    </div>
                )) : <p class="no-projects">No projects yet — check back soon!</p>}
            </section>

            <hr>

            <h2 class="category-heading">Cybersecurity</h2>
            <section class="projects-grid">
                {cyberProjects.length > 0 ? cyberProjects.map(project => (
                    <div class="project-row">
                        <h2>{project.data.title}</h2>
                        <a class="project-card" href={project.data.link ?? `/projects/${project.id}`}>
                            <img src={project.data.image} alt={`${project.data.title} Screenshot`} class="project-img" />
                            <div class="overlay">
                                <div class="overlay-content">
                                    <span class="overlay-title">{project.data.title}</span>
                                    <p class="overlay-desc">{project.data.description}</p>
                                </div>
                            </div>
                        </a>
                    </div>
                )) : <p class="no-projects">No projects yet — check back soon!</p>}
            </section>
        </div>
    </div>

    <footer id="contact">
        <p>2025 Luke Boulter All rights reserved</p>
    </footer>

    <div id="little-man">
        <img id="man-image" src="/Images/maninactive.gif" alt="Little Man">
        <div id="speech-bubble"></div>
    </div>

    <img id="ufo" src="/Images/ufo.png" alt="UFO">

    <script is:inline src="/littleman.js"></script>
</body>
</html>