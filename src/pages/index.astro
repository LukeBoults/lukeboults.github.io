---
import { getCollection } from 'astro:content';
const passionsData = await getCollection('passions');
const passions = passionsData[0]?.data;
---

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Luke Boulter: Game Developer</title>
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png">
    <link rel="stylesheet" href="/style.css">
    <link href="https://fonts.googleapis.com/css2?family=Source+Code+Pro:wght@400;700&display=swap" rel="stylesheet">
</head>
<body>
    <nav class="navbar">
        <ul>
            <li><a class="home-btn" href="/">Home</a></li>
            <li><a href="/projects">Projects</a></li>
            <li><a href="/blog">Blog</a></li>
            <li><a href="/ppitch">Project Pitch</a></li>
        </ul>
    </nav>

    <div class="main-layout">
        <div class="content-backdrop">
            <header id="hero">
                <div class="header-flex">
                    <img src="/Images/lukepicture.jpg" alt="Luke Boulter" class="profile-pic" />
                    <div class="my-name">
                        <h1>Luke Boulter: Cybersecurity Student</h1>
                        <p class="intro-text">
                            Nice to meet you! I'm a Cybersecurity Student based in Brisbane with a passion for the networking and security aspects of Cybersecurity.
                            As I complete my masters degree I hope to pick up and refine various skills that will make me a well-rounded professional.
                        </p>
                        <p class="contact-line">
                            <strong>Get in Touch!</strong>  lbenquiries2672@gmail.com
                        </p>
                        <div class="social-links">
                            <a href="https://www.linkedin.com/in/luke-boulter-5b6928321" class="social-btn">LinkedIn</a>
                            <a href="https://docs.google.com/document/d/1lC6zW6QyFo5IjuLnCmYo3lX9XuMji6_EkQzmSo7j0D8/edit?usp=sharing" class="social-btn">Resume</a>
                        </div>
                    </div>
                </div>
            </header>

            <hr>

            <section id="projects">
                <h2>More About Me</h2>
                <p class="intro-text">
                    During my bachelor's degree, I developed a broad range of skills that make me a valuable addition to any team.
                    I've gained strong experience with Unity, Unreal Engine and Blender, allowing me to adapt to various project roles.
                    Recently, I've focused on expanding my knowledge in particles, cinemachine, and shader graphs.
                </p>
                <p class="intro-text">
                    With my masters degree, I aim to further enhance my skills in networking, security, and programming, 
                    preparing me for a successful career in the cybersecurity field.
                </p>
                <p class="intro-text">
                    I know there's always more to learn, and I'm excited to improve every day.
                </p>
                <p>
                    View some of my projects here!
                </p>
                <div class="social-links">
                    <a href="/projects" class="project-btn">Projects</a>
                </div>
            </section>

            <hr>

            <section id="about">
                <h2>Hard Skills</h2>
                <ul class="sample-list">
                    <li>C#, Python, HTMl5, CSS, SQL</li>
                    <li>Unity, Unreal Engine, Blender, Maya</li>
                    <li>Github, Fork, Trello</li>
                </ul>
            </section>

            <section id="about">
                <h2>Soft Skills</h2>
                <ul class="sample-list">
                    <li>Communication, Teamwork, Problem Solving</li>
                    <li>Adaptability, Time Management, Ownership</li>
                    <li>Creativity, Critical Thinking, Loyalty</li>
                </ul>
            </section>
        </div>

        <hr>

        <div class="side-boxes">
            <section id="whats-new">
                <h2>What's New</h2>
                <div class="news-box">
                    <div id="whats-new-scroll">
                        <div class="scroll-content"></div>
                    </div>
                </div>
            </section>

            {passions && (
                <section id="currently-working">
                    <h2>Passions</h2>
                    <ul>
                        <li><strong>Working on:</strong> {passions.working_on}</li>
                        <li><strong>Learning:</strong> {passions.learning}</li>
                        <li><strong>Current Addiction:</strong> {passions.current_addiction}</li>
                        <li><strong>Favourite Song:</strong> {passions.favourite_song}</li>
                    </ul>
                </section>
            )}
        </div>
    </div>

    <!-- Contact Section -->
    <section id="contact-form">
        <h2>Contact Me</h2>
        <form id="contact-form-el" class="contact-box" action="https://formspree.io/f/xandwoyz" method="POST">
            <label>
                <span>Name</span>
                <input type="text" name="name" required>
            </label>
            <label>
                <span>Email</span>
                <input type="email" name="email" required>
            </label>
            <label>
                <span>Message</span>
                <textarea name="message" rows="5" required></textarea>
            </label>
            <input type="text" name="_gotcha" tabindex="-1" autocomplete="off" style="position:absolute;left:-9999px;height:0;width:0;opacity:0;">
            <button type="submit">Send Message</button>
            <div id="contact-status" class="status" role="status" aria-live="polite"></div>
        </form>
    </section>

    <footer id="contact">
        <p>2025 Luke Boulter All rights reserved</p>
    </footer>

    <div id="little-man">
        <img id="man-image" src="/Images/maninactive.gif" alt="Little Man">
        <div id="speech-bubble"></div>
    </div>

    <img id="ufo" src="/Images/ufo.png" alt="UFO">

    <script is:inline src="/contact-form.js" defer></script>
    <script is:inline src="/littleman.js"></script>
    <script is:inline src="/whatsnew-loader.js"></script>
</body>
</html>